{
    // --- Code navigation with clangd (reads build-vscode/compile_commands.json) ---
    "clangd.path": "C:/msys64/ucrt64/bin/clangd.exe",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build-vscode",
        "--query-driver=C:/msys64/ucrt64/bin/*.exe",
        "--header-insertion=never",
        "--background-index"
    ],

    // Microsoft's C/C++ extension is only used for debugging (gdb); clangd does IntelliSense
    "C_Cpp.intelliSenseEngine": "disabled",

    // --- Building with CMake Tools, using the MSYS2 UCRT64 toolchain ---
    "cmake.cmakePath": "C:/msys64/ucrt64/bin/cmake.exe",
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build-vscode",
    "cmake.configureSettings": {
        "QT_PACKAGE_NAME": "Qt6",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe"
    },
    "cmake.environment": {
        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
    },

    "files.associations": {
        "*.h": "cpp"
    }
}
